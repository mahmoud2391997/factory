generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("WORKFORCE_DATABASE_URL")
}

enum WorkforceEmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum WorkforceTaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum WorkforceTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model WorkforceUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  profileId    String?  @unique

  profile     WorkforceProfile? @relation("UserProfile", fields: [profileId], references: [id], onDelete: SetNull)
  memberships WorkforceTeamMember[]
  ownedTeams  WorkforceTeam[] @relation("WorkforceTeamOwner")

  createdAt DateTime @default(now())
}

model WorkforceTeam {
  id      String @id @default(cuid())
  name    String
  ownerId String

  owner WorkforceUser @relation("WorkforceTeamOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members       WorkforceTeamMember[]
  profiles      WorkforceProfile[]
  departments   WorkforceDepartment[]
  employees     WorkforceEmployee[]
  tasks         WorkforceTask[]
  invitations   WorkforceInvitation[]
  notifications WorkforceNotification[]
  roles         WorkforceCustomRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkforceProfile {
  id        String @id @default(cuid())
  email     String @unique
  firstName String?
  lastName  String?
  role      String @default("EMPLOYEE")
  teamId    String?

  user WorkforceUser? @relation("UserProfile")
  team WorkforceTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  employees     WorkforceEmployee[] @relation("WorkforceEmployeeProfile")
  assignedTasks WorkforceTask[] @relation("WorkforceTaskAssignee")
  createdTasks  WorkforceTask[] @relation("WorkforceTaskCreator")
  notifications WorkforceNotification[]
  managedDepartments WorkforceDepartment[] @relation("DepartmentManager")
  managedEmployees   WorkforceEmployee[]   @relation("EmployeeManager")
  sentInvitations    WorkforceInvitation[] @relation("InvitationSender")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

model WorkforceTeamMember {
  id       String @id @default(cuid())
  userId   String
  teamId   String
  role     String @default("EMPLOYEE")
  isActive Boolean @default(true)

  user WorkforceUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  team WorkforceTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model WorkforceDepartment {
  id        String @id @default(cuid())
  teamId    String
  name      String
  icon      String?
  managerId String?

  team    WorkforceTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  manager WorkforceProfile? @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  employees WorkforceEmployee[]
  tasks     WorkforceTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

model WorkforceEmployee {
  id           String @id @default(cuid())
  teamId       String
  profileId    String
  departmentId String?

  position  String?
  joinDate  DateTime?
  salary    Decimal?
  status    WorkforceEmployeeStatus @default(ACTIVE)
  managerId String?

  team       WorkforceTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  profile    WorkforceProfile @relation("WorkforceEmployeeProfile", fields: [profileId], references: [id], onDelete: Cascade)
  department WorkforceDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager    WorkforceProfile? @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([departmentId])
  @@index([profileId])
}

model WorkforceTask {
  id           String @id @default(cuid())
  teamId       String
  title        String
  description  String?
  priority     WorkforceTaskPriority @default(MEDIUM)
  status       WorkforceTaskStatus @default(TODO)
  departmentId String?
  assigneeId   String?
  createdById  String?
  dueDate      DateTime?

  team       WorkforceTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  department WorkforceDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignee   WorkforceProfile? @relation("WorkforceTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    WorkforceProfile? @relation("WorkforceTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([status])
  @@index([priority])
  @@index([departmentId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([dueDate])
}

model WorkforceInvitation {
  id          String @id @default(cuid())
  teamId      String
  email       String
  role        String
  token       String @unique
  expiresAt   DateTime?
  invitedById String
  acceptedAt  DateTime?

  team      WorkforceTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy WorkforceProfile @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([email])
}

model WorkforceNotification {
  id      String @id @default(cuid())
  userId  String
  type    String
  title   String
  message String
  data    Json?
  read    Boolean @default(false)
  teamId  String?

  user WorkforceProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  team WorkforceTeam?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([teamId])
}

model WorkforceCustomRole {
  id          String @id @default(cuid())
  teamId      String
  name        String
  label       String
  permissions Json  @default("[]")

  team WorkforceTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, name])
  @@index([teamId])
}

