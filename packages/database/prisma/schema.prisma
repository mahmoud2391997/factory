generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoleKey {
  SUPER_ADMIN
  MANAGEMENT
  WAREHOUSE
  PRODUCTION
  ACCOUNTANT
  HR
  SALES
}

enum WarehouseKey {
  WH_RAW
  WH_MFG
  WH_FG
}

model SystemInit {
  id            String   @id
  initializedAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)

  roles UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String      @id @default(cuid())
  key         UserRoleKey @unique
  nameAr      String
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  nameAr      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model CompanySettings {
  id String @id @default(cuid())

  currencyCode String @default("OMR")

  // variance threshold in percent (e.g. 2.50)
  productionVarianceThresholdPct Decimal @default(0.00) @db.Decimal(5, 2)

  taxRegistrationNumber String?
  taxRatePct            Decimal @default(0.00) @db.Decimal(5, 2)
  taxInclusivePricing   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id       String       @id @default(cuid())
  key      WarehouseKey @unique
  nameAr   String
  isActive Boolean      @default(true)

  locations WarehouseLocation[]
  inventoryBalances InventoryBalance[]
  ledgerEntries InventoryLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Versioned operational document for the feed-factory ERP.
/// Cloud Postgres is the source of truth when DATABASE_URL is set.
/// A local JSON copy is written beside the app for the on-site backup.
model ErpDocument {
  id        String   @id
  version   Int      @default(0)
  payload   Json
  updatedAt DateTime @updatedAt
}

model ArchiveRecord {
  id         String   @id
  kind       String
  at         DateTime
  payload    Json
  archivedAt DateTime @default(now())

  @@index([kind, at])
}

model WarehouseLocation {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  code     String
  nameAr   String
  isActive Boolean @default(true)

  balances InventoryBalance[]
  ledgerEntries InventoryLedgerEntry[]

  createdAt DateTime @default(now())

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

enum VatTreatment {
  STANDARD
  ZERO
  EXEMPT
}

enum CatalogItemType {
  MATERIAL
  PRODUCT
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONFIRMED
  PARTIAL
  PAID
  RECEIVED
  COMPLETED
  RELEASED
}

model Material {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  category String
  unit String
  minQty Decimal @default(0) @db.Decimal(14, 3)
  vatTreatment VatTreatment @default(STANDARD)
  barcode String @unique
  active Boolean @default(true)

  recipeItems RecipeItem[]
  purchaseLines PurchaseOrderLine[]
  receiptLines GoodsReceiptLine[]
  inventoryBalances InventoryBalance[]
  ledgerEntries InventoryLedgerEntry[]
  productionInputs ProductionInput[]
  suppliedBatchLinks BatchMaterialLink[]
  qualitySamples QualitySample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  unit String
  salePrice Decimal @default(0) @db.Decimal(14, 3)
  vatTreatment VatTreatment @default(STANDARD)
  barcode String @unique
  bagKg Decimal @default(0) @db.Decimal(14, 3)
  active Boolean @default(true)
  customerId String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recipes Recipe[]
  inventoryBalances InventoryBalance[]
  ledgerEntries InventoryLedgerEntry[]
  productionOrders ProductionOrder[]
  invoiceLines SalesInvoiceLine[]
  productionLots ProductionLot[]
  qualitySamples QualitySample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  vatNumber String
  phone String
  email String
  address String
  purchaseOrders PurchaseOrder[]
  suppliedBatches BatchMaterialLink[]
  communications SupplierCommunication[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  vatNumber String
  phone String
  email String
  address String
  invoices SalesInvoice[]
  deliveredLots ProductionLot[]
  lotDeliveries LotDelivery[]
  customProducts Product[]
  customRecipes Recipe[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  department String
  jobTitle String
  basicSalary Decimal @default(0) @db.Decimal(14, 3)
  active Boolean @default(true)
  idNumber String?
  idExpiryDate DateTime?
  contractExpiryDate DateTime?
  vacationBalance Decimal @default(0) @db.Decimal(5, 2)
  attendance Attendance[]
  payrollLines PayrollLine[]
  productionLots ProductionLot[]
  fuelLogs FuelLog[]
  trips TripLog[]
  managedDocuments CompanyDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recipe {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  nameAr String
  baseOutputQty Decimal @db.Decimal(14, 3)
  items RecipeItem[]
  productionOrders ProductionOrder[]
  @@index([productId])
}

model RecipeItem {
  recipeId String
  materialId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  qty Decimal @db.Decimal(14, 3)
  @@id([recipeId, materialId])
  @@index([materialId])
}

model InventoryBalance {
  id String @id @default(cuid())
  warehouseId String
  locationId String?
  itemType CatalogItemType
  materialId String?
  productId String?
  batchNo String
  qty Decimal @default(0) @db.Decimal(14, 3)
  unitCost Decimal @default(0) @db.Decimal(14, 3)
  expiryDate DateTime?
  receivedAt DateTime
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  material Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([warehouseId, locationId, itemType, materialId, productId, batchNo])
  @@index([materialId])
  @@index([productId])
}

model InventoryLedgerEntry {
  id String @id @default(cuid())
  at DateTime @default(now())
  type String
  warehouseId String
  locationId String?
  itemType CatalogItemType
  materialId String?
  productId String?
  batchNo String
  qty Decimal @db.Decimal(14, 3)
  unitCost Decimal @db.Decimal(14, 3)
  prevQty Decimal @db.Decimal(14, 3)
  newQty Decimal @db.Decimal(14, 3)
  refType String
  refId String
  userId String
  notes String
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  material Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([warehouseId, at])
  @@index([materialId])
  @@index([productId])
  @@index([refType, refId])
}

model PurchaseOrder {
  id String @id @default(cuid())
  number String @unique
  supplierId String
  status DocumentStatus @default(PENDING_APPROVAL)
  notes String
  createdBy String
  createdAt DateTime @default(now())
  decidedBy String?
  decidedAt DateTime?
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines PurchaseOrderLine[]
  receipts GoodsReceipt[]
  @@index([supplierId, status])
}

model PurchaseOrderLine {
  id String @id @default(cuid())
  purchaseOrderId String
  materialId String
  qty Decimal @db.Decimal(14, 3)
  unitCost Decimal @db.Decimal(14, 3)
  receivedQty Decimal @default(0) @db.Decimal(14, 3)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  @@index([materialId])
}

model GoodsReceipt {
  id String @id @default(cuid())
  number String @unique
  purchaseOrderId String
  at DateTime @default(now())
  createdBy String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines GoodsReceiptLine[]
}

model GoodsReceiptLine {
  id String @id @default(cuid())
  goodsReceiptId String
  materialId String
  qty Decimal @db.Decimal(14, 3)
  unitCost Decimal @db.Decimal(14, 3)
  batchNo String
  expiryDate DateTime?
  receipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  @@index([materialId])
}

model ProductionOrder {
  id String @id @default(cuid())
  number String @unique
  productId String
  recipeId String
  plannedQty Decimal @db.Decimal(14, 3)
  status DocumentStatus @default(RELEASED)
  actualOutputQty Decimal @default(0) @db.Decimal(14, 3)
  totalCost Decimal @default(0) @db.Decimal(14, 3)
  unitCost Decimal @default(0) @db.Decimal(14, 3)
  outputBatch String
  varianceReason String
  createdBy String
  createdAt DateTime @default(now())
  completedAt DateTime?
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  inputs ProductionInput[]
  lots ProductionLot[]
  costLines ProductionCostLine[]
  @@index([productId, status])
}

model ProductionInput {
  id String @id @default(cuid())
  productionOrderId String
  materialId String
  expectedQty Decimal @db.Decimal(14, 3)
  actualQty Decimal @db.Decimal(14, 3)
  wasteQty Decimal @db.Decimal(14, 3)
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  @@index([materialId])
}

model SalesInvoice {
  id String @id @default(cuid())
  number String @unique
  customerId String
  status DocumentStatus @default(DRAFT)
  issuedAt DateTime @default(now())
  notes String
  subtotal Decimal @db.Decimal(14, 3)
  vatAmount Decimal @db.Decimal(14, 3)
  total Decimal @db.Decimal(14, 3)
  paidAmount Decimal @default(0) @db.Decimal(14, 3)
  createdBy String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines SalesInvoiceLine[]
  payments SalesPayment[]
  @@index([customerId, status])
}

model SalesInvoiceLine {
  id String @id @default(cuid())
  invoiceId String
  productId String
  qty Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 3)
  vatTreatment VatTreatment
  vatRatePct Decimal @db.Decimal(5, 2)
  net Decimal @db.Decimal(14, 3)
  vat Decimal @db.Decimal(14, 3)
  total Decimal @db.Decimal(14, 3)
  batchNo String
  unitCost Decimal @db.Decimal(14, 3)
  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([productId])
}

model SalesPayment {
  id String @id @default(cuid())
  number String @unique
  invoiceId String
  amount Decimal @db.Decimal(14, 3)
  method String
  at DateTime @default(now())
  createdBy String
  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
}

model Account {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  type String
  journalLines JournalLine[]
}

model JournalEntry {
  id String @id @default(cuid())
  number String @unique
  at DateTime @default(now())
  memo String
  refType String
  refId String
  lines JournalLine[]
}

model JournalLine {
  id String @id @default(cuid())
  journalEntryId String
  accountId String
  debit Decimal @default(0) @db.Decimal(14, 3)
  credit Decimal @default(0) @db.Decimal(14, 3)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId])
}

model Attendance {
  id String @id @default(cuid())
  employeeId String
  date DateTime
  checkIn DateTime
  checkOut DateTime
  source String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@unique([employeeId, date])
}

model PayrollLine {
  id String @id @default(cuid())
  payrollRunId String
  employeeId String
  basic Decimal @db.Decimal(14, 3)
  overtimeHours Decimal @db.Decimal(14, 3)
  overtimeAmount Decimal @db.Decimal(14, 3)
  allowances Decimal @db.Decimal(14, 3)
  deductions Decimal @db.Decimal(14, 3)
  gross Decimal @db.Decimal(14, 3)
  net Decimal @db.Decimal(14, 3)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

model PayrollRun {
  id String @id @default(cuid())
  number String @unique
  month String
  status DocumentStatus @default(PENDING_APPROVAL)
  totalNet Decimal @db.Decimal(14, 3)
  createdBy String
  createdAt DateTime @default(now())
  decidedBy String?
  lines PayrollLine[]
}

enum QualitySampleType {
  RAW_MATERIAL
  FINISHED_PRODUCT
}

enum QualityResultStatus {
  PENDING
  PASSED
  FAILED
  HOLD
}

enum ProductionCostType {
  RAW_MATERIAL
  BAGS
  ELECTRICITY
  GAS
  LABOR
  TRANSPORT
  MAINTENANCE
  OVERHEAD
}

/// NOT IMPLEMENTED: engine state is the source of truth
model ProductionLot {
  id              String   @id @default(cuid())
  lotNo           String   @unique
  productionOrderId String
  productId       String
  operatorId      String?
  customerId      String?
  manufacturedAt  DateTime
  expectedQty     Decimal  @db.Decimal(14, 3)
  actualQty       Decimal  @db.Decimal(14, 3)
  wasteQty        Decimal  @default(0) @db.Decimal(14, 3)
  varianceQty     Decimal  @default(0) @db.Decimal(14, 3)
  variancePct     Decimal  @default(0) @db.Decimal(7, 3)
  totalCost       Decimal  @default(0) @db.Decimal(14, 3)
  costPerTon      Decimal  @default(0) @db.Decimal(14, 3)
  salePricePerTon Decimal  @default(0) @db.Decimal(14, 3)
  marginPerTon    Decimal  @default(0) @db.Decimal(14, 3)
  notes           String?

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  operator Employee? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  materials BatchMaterialLink[]
  qualitySamples QualitySample[]
  costLines ProductionCostLine[]
  deliveries LotDelivery[]
  createdAt DateTime @default(now())

  @@index([productId, manufacturedAt])
  @@index([customerId])
}

/// NOT IMPLEMENTED: engine state is the source of truth
model BatchMaterialLink {
  id String @id @default(cuid())
  productionLotId String
  materialId String
  supplierId String?
  sourceBatchNo String
  qty Decimal @db.Decimal(14, 3)
  unitCost Decimal @db.Decimal(14, 3)
  productionLot ProductionLot @relation(fields: [productionLotId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([sourceBatchNo])
  @@index([supplierId])
}

/// NOT IMPLEMENTED: engine state is the source of truth
model QualitySample {
  id String @id @default(cuid())
  productionLotId String?
  materialId String?
  productId String?
  type QualitySampleType
  sampledAt DateTime @default(now())
  sampledBy String
  moisturePct Decimal? @db.Decimal(7, 3)
  proteinPct Decimal? @db.Decimal(7, 3)
  ashPct Decimal? @db.Decimal(7, 3)
  result QualityResultStatus @default(PENDING)
  notes String?
  productionLot ProductionLot? @relation(fields: [productionLotId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productionLotId, result])
  @@index([materialId, sampledAt])
  @@index([productId, sampledAt])
}

/// NOT IMPLEMENTED: engine state is the source of truth
model ProductionCostLine {
  id String @id @default(cuid())
  productionOrderId String
  productionLotId String?
  type ProductionCostType
  description String
  amount Decimal @db.Decimal(14, 3)
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionLot ProductionLot? @relation(fields: [productionLotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productionOrderId, type])
}

/// NOT IMPLEMENTED: engine state is the source of truth
model LotDelivery {
  id String @id @default(cuid())
  productionLotId String
  customerId String
  deliveredQty Decimal @db.Decimal(14, 3)
  deliveredAt DateTime @default(now())
  referenceNo String?
  productionLot ProductionLot @relation(fields: [productionLotId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, deliveredAt])
}

/// Cold copy of audit rows removed from the live ErpDocument.
model AuditLog {
  id       String   @id
  at       DateTime
  userId   String
  userName String
  action   String
  entity   String
  entityId String
  detail   String

  @@index([at])
}



// -----------------------------------------------------------------
// New Modules: Fleet, Finance, Maintenance, Documents, Utilities
// -----------------------------------------------------------------

/// NOT IMPLEMENTED: engine state is the source of truth
model Vehicle {
  id String @id @default(cuid())
  plateNumber String @unique
  make String
  model String
  year Int
  insuranceExpiry DateTime?
  registrationExpiry DateTime?
  active Boolean @default(true)

  maintenance VehicleMaintenance[]
  fuelLogs FuelLog[]
  trips TripLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// NOT IMPLEMENTED: engine state is the source of truth
model VehicleMaintenance {
  id String @id @default(cuid())
  vehicleId String
  type String // e.g. TIRE_CHANGE, OIL_CHANGE, REPAIR
  description String
  cost Decimal @db.Decimal(14, 3)
  date DateTime @default(now())
  nextDueDate DateTime?
  nextDueKm Int?
  odometer Int

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

/// NOT IMPLEMENTED: engine state is the source of truth
model FuelLog {
  id String @id @default(cuid())
  vehicleId String
  date DateTime @default(now())
  liters Decimal @db.Decimal(10, 2)
  cost Decimal @db.Decimal(14, 3)
  odometer Int
  driverId String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver Employee? @relation(fields: [driverId], references: [id], onDelete: Restrict)
}

/// NOT IMPLEMENTED: engine state is the source of truth
model TripLog {
  id String @id @default(cuid())
  vehicleId String
  driverId String
  date DateTime @default(now())
  destination String
  startOdometer Int
  endOdometer Int
  distanceKm Int
  loadDescription String?
  loadWeightKg Decimal? @db.Decimal(10, 2)
  fuelUsedLiters Decimal? @db.Decimal(10, 2)
  tripCost Decimal @default(0) @db.Decimal(14, 3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver Employee @relation(fields: [driverId], references: [id], onDelete: Restrict)
}

/// NOT IMPLEMENTED: engine state is the source of truth
model FinancialObligation {
  id String @id @default(cuid())
  beneficiary String
  description String
  totalAmount Decimal @db.Decimal(14, 3)
  installmentAmount Decimal @db.Decimal(14, 3)
  paidAmount Decimal @default(0) @db.Decimal(14, 3)
  remainingAmount Decimal @db.Decimal(14, 3)
  dueDate DateTime
  status DocumentStatus @default(PENDING_APPROVAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// NOT IMPLEMENTED: engine state is the source of truth
model BankTransaction {
  id String @id @default(cuid())
  referenceId String @unique
  date DateTime
  type String // DEBIT / CREDIT
  amount Decimal @db.Decimal(14, 3)
  description String
  reconciled Boolean @default(false)
  notes String?

  createdAt DateTime @default(now())
}

/// NOT IMPLEMENTED: engine state is the source of truth
model Machine {
  id String @id @default(cuid())
  code String @unique
  nameAr String
  location String?
  runningHours Int @default(0)
  active Boolean @default(true)

  maintenanceLogs MachineMaintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// NOT IMPLEMENTED: engine state is the source of truth
model MachineMaintenance {
  id String @id @default(cuid())
  machineId String
  type String // PREVENTIVE, BREAKDOWN
  description String
  cost Decimal @db.Decimal(14, 3)
  downTimeHours Decimal @default(0) @db.Decimal(10, 2)
  date DateTime @default(now())
  nextDueDate DateTime?
  sparePartsUsed String? // Storing JSON or comma separated for simplicity

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

/// NOT IMPLEMENTED: engine state is the source of truth
model CompanyDocument {
  id String @id @default(cuid())
  title String
  type String // LICENSE, CONTRACT, LEASE
  entityName String?
  issueDate DateTime?
  expiryDate DateTime?
  cost Decimal? @db.Decimal(14, 3)
  fileUrl String?
  responsibleId String?

  responsible Employee? @relation(fields: [responsibleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// NOT IMPLEMENTED: engine state is the source of truth
model UtilityMeter {
  id String @id @default(cuid())
  type String // ELECTRICITY, WATER, GAS
  identifier String
  location String?

  readings UtilityReading[]
}

/// NOT IMPLEMENTED: engine state is the source of truth
model UtilityReading {
  id String @id @default(cuid())
  meterId String
  date DateTime
  value Decimal @db.Decimal(14, 3)
  consumption Decimal @db.Decimal(14, 3)
  cost Decimal @db.Decimal(14, 3)

  meter UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
}

/// NOT IMPLEMENTED: engine state is the source of truth
model SupplierCommunication {
  id String @id @default(cuid())
  supplierId String
  type String // RFQ, INQUIRY
  status String // DRAFT, SENT, REPLIED
  messageTemplate String
  sentAt DateTime?
  approvedBy String?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

