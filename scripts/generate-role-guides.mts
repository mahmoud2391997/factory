import { mkdir, readFile, writeFile } from 'node:fs/promises'
import { ROLE_LABELS, DEFAULT_ROLE_PERMISSIONS, PERMISSIONS_VERSION, type RoleKey } from '../apps/web/lib/erp/domain/permissions'
import { PERMISSION_LABELS } from '../apps/web/lib/erp/permission-copy'
const check=process.argv.includes('--check')
const escape=(value:string)=>value.replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]!))
const style='body{font-family:Arial,sans-serif;max-width:900px;margin:30px auto;padding:20px;line-height:1.9;color:#17302b}h1,h2{color:#17302b}li{margin:6px 0}table{width:100%;border-collapse:collapse}td,th{border:1px solid #aaa;padding:9px}a{color:#174f70}@media print{body{margin:0}.no-print{display:none}h2{break-after:avoid}li{break-inside:avoid}}'
const html=(title:string,body:string)=>`<!doctype html><html lang="ar" dir="rtl"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${escape(title)}</title><style>${style}</style><body><h1>${escape(title)}</h1>${body}</body></html>\n`
const files=new Map<string,string>();const roles=Object.keys(ROLE_LABELS) as RoleKey[]
for(const role of roles){
 const permissions=DEFAULT_ROLE_PERMISSIONS[role]
 for(const permission of permissions)if(!PERMISSION_LABELS[permission])throw Error('Missing permission description: '+permission)
 const body=`<p>مولد من تعريف الصلاحيات الفعلي، الإصدار ${PERMISSIONS_VERSION}. هذا دليل للصلاحيات الافتراضية؛ الصلاحيات التي يعدلها المالك وشروط السجل والموافقة تبقى حاكمة.</p><h2>ابدأ التجربة</h2><ol><li>استخدم حسابك المخصص وغيّر كلمة المرور عند طلب النظام.</li><li>تحقق من الدور الظاهر، وابدأ بسجلات اصطناعية أثناء القبول.</li><li>افحص نتيجة الحفظ ثم أعد فتح السجل للتأكد من بقاء التعديل.</li><li>سجل أي منع غير متوقع أو نتيجة غير صحيحة للمراجعة.</li></ol><h2>ما يسمح به الدور افتراضيًا</h2><ul>${permissions.map(permission=>`<li>${escape(PERMISSION_LABELS[permission])}</li>`).join('')}</ul><h2>اختبار القبول للدور</h2><p>لكل إجراء أعلاه، افتح شاشته، نفذه بسجل اصطناعي، وأثبت الحفظ وإعادة القراءة. افحص إجراءً لا يملكه الدور وتأكد من منعه. لا تنفذ رسائل أو مدفوعات حقيقية.</p><p>وجود صلاحية عامة لا يتجاوز ضوابط الخادم: مثل استقلال بعض الاعتمادات، أو اشتراط المدير العام لمراجعة البريد. قراءة الإشعار لا تؤكد تسليم البريد.</p><table><tr><th>المراجع</th><th>تاريخ التجربة</th><th>النتيجة والملاحظات</th></tr><tr><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr></table>`
 files.set(`docs/roles/ar/${role}.html`,html('دليل '+ROLE_LABELS[role],body))
}
files.set('docs/ROLE-GUIDES.ar.md','# أدلة الأدوار — نظام المصنع\n\nمولدة من الصلاحيات الفعلية الافتراضية؛ تحتاج مراجعة المالك والموظفين. لا تعني اعتماد التشغيل.\n\n'+roles.map(role=>`- [${ROLE_LABELS[role]}](roles/ar/${role}.html) — ${DEFAULT_ROLE_PERMISSIONS[role].length} صلاحية افتراضية.`).join('\n')+'\n\n[قائمة قبول الأدوار القابلة للطباعة](ROLE-ACCEPTANCE-CHECKLIST.ar.html)\n')
files.set('docs/ROLE-ACCEPTANCE-CHECKLIST.ar.html',html('قائمة قبول أدوار نظام المصنع',`<p>هذه قائمة تجربة، وليست إقرارًا بنجاحها. نفذها ببيانات اصطناعية قبل استخدام بيانات العمل.</p><ol><li>☐ تحقق من الدور والصلاحيات الحالية، وقارنها بالدليل المولد.</li><li>☐ أكمل الإجراءات المسموحة واحفظ وأعد فتح السجلات.</li><li>☐ تحقق من منع الإجراءات غير المسموحة عبر الواجهة والخادم.</li><li>☐ افحص العربية واتجاه اليمين إلى اليسار وعلى شاشة هاتف.</li><li>☐ سجل الحالات المعلقة دون تجاوز اعتمادات المالك.</li></ol><table><tr><th>الدور</th><th>الموظف والمراجع</th><th>النتيجة والملاحظات</th></tr>${roles.map(role=>`<tr><td>${escape(ROLE_LABELS[role])}</td><td>&nbsp;</td><td>&nbsp;</td></tr>`).join('')}</table>`))
for(const [file,content]of files){if(check){if(await readFile(file,'utf8')!==content)throw Error('Stale generated guide: '+file)}else{await mkdir(file.slice(0,file.lastIndexOf('/')),{recursive:true});await writeFile(file,content)}}
console.log(`${check?'Verified':'Generated'} ${roles.length} role guides and printable acceptance checklist from actual permission definitions (version ${PERMISSIONS_VERSION}).`)
