{
  "name": "erp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run generate --workspace=packages/database",
    "dev": "npm run dev --workspace=apps/web",
    "prebuild": "npm run generate --workspace=packages/database",
    "build": "npm run build --workspace=apps/web",
    "vercel-build": "pnpm --filter @erp/web vercel-build",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run lint --workspace=apps/web",
    "test": "npm run test:erp",
    "test:erp": "tsx --tsconfig apps/web/tsconfig.json --test \"apps/web/**/*.test.ts\""
  },
  "dependencies": {
    "next": "16.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15"
  }
}
