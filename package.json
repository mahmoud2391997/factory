{
  "name": "erp",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @erp/web dev",
    "predev": "pnpm --filter @erp/database generate",
    "dev:web": "pnpm --filter @erp/web dev",
    "prebuild": "node scripts/check-build-mode.mjs && pnpm --filter @erp/database generate",
    "build": "pnpm --filter @erp/web build",
    "build:web": "pnpm --filter @erp/web build",
    "test": "pnpm test:erp",
    "test:smoke": "node scripts/smoke-test.mjs",
    "vercel-build": "bash scripts/vercel-build.sh",
    "db:deploy": "pnpm --filter @erp/database migrate:deploy",
    "start": "pnpm --filter @erp/web start",
    "start:web": "pnpm --filter @erp/web start",
    "lint": "pnpm --filter @erp/web lint",
    "typecheck": "pnpm --filter @erp/web exec tsc --noEmit",
    "test:erp": "tsx --tsconfig apps/web/tsconfig.json --test \"apps/web/**/*.test.ts\"",
    "check": "pnpm db:generate && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @erp/database generate",
    "db:migrate": "pnpm --filter @erp/database migrate:dev",
    "dev:demo": "pnpm db:generate && node scripts/dev-demo.mjs",
    "benchmark:storage": "node scripts/performance-baseline.mjs",
    "test:browser": "node scripts/browser-regression.cjs",
    "prebuild:web": "node scripts/check-build-mode.mjs && pnpm db:generate",
    "predeploy": "sh scripts/predeploy.sh",
    "test:ui-acceptance": "APP_MODE=production pnpm build:web && node scripts/ui-acceptance.cjs",
    "test:mail-journey": "node scripts/test-mail-journey.cjs",
    "guides:roles": "tsx --tsconfig apps/web/tsconfig.json scripts/generate-role-guides.mts",
    "benchmark:http": "node scripts/benchmark-http.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "next": "16.3.8"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
