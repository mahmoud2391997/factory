{
  "name": "erp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @erp/web run dev",
    "predev": "pnpm --filter @erp/database run generate",
    "dev:web": "pnpm --filter @erp/web run dev",
    "prebuild": "pnpm --filter @erp/database run generate",
    "build": "pnpm --filter @erp/web run build",
    "build:web": "pnpm --filter @erp/web run build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "db:deploy": "npm run migrate:deploy --workspace=@erp/database",
    "start": "npm run start --workspace=@erp/web",
    "start:web": "npm run start --workspace=@erp/web",
    "lint": "npm run lint --workspace=@erp/web",
    "typecheck": "npm run lint --workspace=@erp/web",
    "test:erp": "tsx --test \"apps/web/**/*.test.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15"
  }
}
