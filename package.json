{
  "name": "erp",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "dev:web": "pnpm -C apps/web dev",
    "build:web": "pnpm -C apps/web build",
    "start:web": "pnpm -C apps/web start",
    "dev:api": "pnpm -C apps/api start:dev",
    "build:api": "pnpm -C apps/api build",
    "start:api": "pnpm -C apps/api start:prod",
    "db:studio": "pnpm -C packages/database prisma studio",
    "db:migrate": "pnpm -C packages/database prisma migrate dev",
    "db:deploy": "pnpm -C packages/database prisma migrate deploy",
    "db:seed": "pnpm -C packages/database prisma db seed"
  }
}

