# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp?schema=public"

# On Vercel you may instead have one of these from Storage/Postgres:
# POSTGRES_PRISMA_URL="..."
# POSTGRES_URL="..."
# POSTGRES_URL_NON_POOLING="..."
# The app maps them to DATABASE_URL automatically.

JWT_SECRET="change-me"
SETUP_TOKEN="change-me-too"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_SECONDS="2592000"

# staging | production  — staging shows a banner in the header
NEXT_PUBLIC_APP_ENV="production"

# Link to external Workforce (teams/tasks) system.
# Used by the ERP to redirect the old /tasks screen.
NEXT_PUBLIC_WORKFORCE_URL="http://localhost:3001"

# Optional local backup directory. Defaults to ./data under the web app.
# ERP_DATA_DIR="/var/lib/gulf-feed"

# Email alerts (low stock, approvals). Leave empty to keep alerts inside the app only.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="erp@gulffeed.om"
