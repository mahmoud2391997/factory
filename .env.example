# Application PostgreSQL connection (prefer Neon pooled URL at runtime).
DATABASE_URL=
# Direct/unpooled URL used by Prisma migrations when available.
DATABASE_URL_UNPOOLED=
# Supported Neon/Vercel aliases; DATABASE_URL takes precedence.
NEON_POSTGRES_PRISMA_URL=
NEON_DATABASE_URL=
NEON_POSTGRES_URL=
NEON_DATABASE_URL_UNPOOLED=
NEON_POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
PRISMA_DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
# JWT signing secret: production needs at least 32 non-placeholder characters.
JWT_SECRET=
# One-time bootstrap token: production needs at least 16 non-placeholder characters.
SETUP_TOKEN=
# Use demo only for local/demo testing; never use demo with a real database.
APP_MODE=
# Optional public environment label.
NEXT_PUBLIC_APP_ENV=
# Optional build metadata (Vercel build injects commit SHA and build time).
NEXT_PUBLIC_GIT_COMMIT_SHA=
NEXT_PUBLIC_BUILD_DATE=
# Access JWT lifetime in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh JWT lifetime in seconds.
REFRESH_TOKEN_TTL_SECONDS=2592000
# SMTP server hostname.
SMTP_HOST=
# SMTP server port.
SMTP_PORT=587
# SMTP username.
SMTP_USER=
# SMTP password.
SMTP_PASS=
# Sender address.
SMTP_FROM=
# Whether SMTP uses TLS.
SMTP_SECURE=false
# Token for scale-ingest requests.
ERP_SCALE_INGEST_TOKEN=
# User id used by scale ingestion.
ERP_SCALE_USER_ID=
# Local data and backup directory (on Vercel, /tmp is ephemeral).
ERP_DATA_DIR=
# Optional fixed test clock used by tests only.
ERP_NOW=
# Optional demo-only overrides; do not use these for production login.
DEMO_PASSWORD=
DEMO_JWT_SECRET=
DEMO_SETUP_TOKEN=
# Smoke/seed script inputs; export at invocation time, do not commit real credentials.
SMOKE_EMAIL=
SMOKE_PASSWORD=
SEED_TEST_PASSWORD=
# Do NOT set any SUPABASE_* below for this test; when configured they make login require Supabase Auth.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Platform-managed values; normally do not set manually.
NODE_ENV=
VERCEL=
AWS_LAMBDA_FUNCTION_NAME=
