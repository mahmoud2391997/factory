# Pooled PostgreSQL connection used by the application.
DATABASE_URL=
# Direct/unpooled PostgreSQL connection used for Prisma migrations.
DATABASE_URL_UNPOOLED=
# JWT signing secret; use at least 32 random characters.
JWT_SECRET=
# One-time bootstrap secret; use at least 16 random characters.
SETUP_TOKEN=
# Set demo only for local/demo operation; production defaults to real mode.
APP_MODE=
# Optional public environment label.
NEXT_PUBLIC_APP_ENV=
# Access JWT lifetime in seconds.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh JWT lifetime in seconds.
REFRESH_TOKEN_TTL_SECONDS=2592000
# SMTP server hostname.
SMTP_HOST=
# SMTP server port.
SMTP_PORT=587
# SMTP username.
SMTP_USER=
# SMTP password.
SMTP_PASS=
# Sender address.
SMTP_FROM=
# Whether SMTP uses TLS.
SMTP_SECURE=false
# Token for scale-ingest requests.
ERP_SCALE_INGEST_TOKEN=
# User id used by scale ingestion.
ERP_SCALE_USER_ID=
# Local data and backup directory.
ERP_DATA_DIR=

# Do NOT set SUPABASE_* for this test; it enables Supabase Auth during login.
